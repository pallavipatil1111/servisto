# Copy to .env and fill in. .env is ignored by git.

# Signs session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Where the SQLite database lives (default: instance/servisto.db)
# DATABASE_PATH=instance/servisto.db

# Create the demo accounts and bookings when the database is empty
SEED_DEMO_DATA=true

# Set to true when the site is served over HTTPS
SECURE_COOKIES=false

# Only for local development
FLASK_DEBUG=false
